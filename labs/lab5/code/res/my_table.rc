// my_table.rc — table dialog resource (independent)
#include <windows.h>
#include "my_table.h"

IDD_TABLE_DIALOG DIALOGEX 0, 0, 300, 232
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_VISIBLE
CAPTION "Objects Table"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LISTBOX IDC_TABLE_LIST, 5, 5, 290, 195, WS_VSCROLL | WS_TABSTOP | LBS_NOTIFY | LBS_USETABSTOPS
    DEFPUSHBUTTON "&Delete selected", IDC_TABLE_DELETE, 195, 204, 100, 22
END
