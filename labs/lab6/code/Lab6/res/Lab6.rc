// Lab6.rc — dialog resource for Lab6 manager
#pragma once

#define IDD_MAIN_DLG     200
#define IDC_EDIT_NPOINT  201
#define IDC_EDIT_XMIN    202
#define IDC_EDIT_XMAX    203
#define IDC_EDIT_YMIN    204
#define IDC_EDIT_YMAX    205
#define IDC_BTN_RUN      206
#define IDC_BTN_CLOSE    207

IDD_MAIN_DLG DIALOGEX 0, 0, 280, 200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Lab 6 — Manager"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Number of points:",-1,10,10,120,12
    EDITTEXT        IDC_EDIT_NPOINT,140,10,120,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "X min:",-1,10,30,120,12
    EDITTEXT        IDC_EDIT_XMIN,140,30,120,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "X max:",-1,10,50,120,12
    EDITTEXT        IDC_EDIT_XMAX,140,50,120,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Y min:",-1,10,70,120,12
    EDITTEXT        IDC_EDIT_YMIN,140,70,120,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Y max:",-1,10,90,120,12
    EDITTEXT        IDC_EDIT_YMAX,140,90,120,14,ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "Run",IDC_BTN_RUN,60,130,70,20
    PUSHBUTTON      "Close",IDC_BTN_CLOSE,150,130,70,20
END
